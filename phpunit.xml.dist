<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <!-- Règles métier, rendus, contrôleurs, et DAO / intégration sur la base du CI (sautés sans DB_*). -->
        <testsuite name="aura">
            <directory>tests</directory>
            <exclude>tests/Http</exclude>
        </testsuite>
        <!-- Bout en bout : un serveur php -S sert l'application sur la base du CI (sautés sans DB_*). -->
        <testsuite name="http">
            <directory>tests/Http</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
